# ========================================
# Matching Engine - 環境変数テンプレート
# ========================================
# このファイルをコピーして .env ファイルを作成してください
# cp .env.example .env
#
# 重要: .env ファイルは絶対にコミットしないでください！
# ========================================

# ========================================
# アプリケーション設定
# ========================================
# 環境 (development, production, test)
ENVIRONMENT=development

# サーバー設定
PORT=8080
HOST=0.0.0.0

# ログレベル (debug, info, warn, error)
LOG_LEVEL=info

# ========================================
# データベース設定 (PostgreSQL 18)
# ========================================
# 開発環境用（compose.yamlと合わせる）
DB_HOST=localhost
DB_PORT=5432
DB_USER=matching
DB_PASSWORD=matching
DB_NAME=matching_engine
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=300

# 本番環境用（実際の値に置き換える）
# DB_HOST=your-production-db-host
# DB_PORT=5432
# DB_USER=prod_user
# DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
# DB_NAME=matching_engine_prod
# DB_SSLMODE=require
# DB_MAX_CONNS=100
# DB_MIN_CONNS=5
# DB_CONN_MAX_LIFETIME=600

# ========================================
# テスト設定（testcontainers）
# ========================================
# 既存の PostgreSQL を使う場合は管理DBの接続文字列を指定する（CI のサービスコンテナなど）
# TEST_DATABASE_ADMIN_DSN=postgres://test:test@localhost:5432/postgres?sslmode=disable
# コンテナ再利用を無効にする場合（テストごとに起動・破棄）
# TESTCONTAINERS_REUSE=false
# colima 利用時は Docker ソケットを明示する
# DOCKER_HOST=unix:///Users/<you>/.colima/default/docker.sock
# TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

# ========================================
# セキュリティ設定
# ========================================
# JWT秘密鍵（本番環境では必ず変更すること！）
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# APIキー（外部サービス連携用）
# API_KEY=your-api-key-here

# CORS設定（カンマ区切りで複数のオリジンを指定）
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ========================================
# マッチングエンジン設定
# ========================================
# デフォルトマッチング閾値 (0.0 - 1.0)
MATCHING_THRESHOLD=0.7

# 最大マッチング候補数
MAX_MATCHING_CANDIDATES=100

# ========================================
# 外部サービス設定
# ========================================
# AWS設定（本番環境用）
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# GCP設定（本番環境用）
# GCP_PROJECT_ID=your-project-id
# GCP_CREDENTIALS_PATH=/path/to/credentials.json

# ========================================
# 監視・メトリクス設定
# ========================================
# Prometheus/Grafana
# METRICS_ENABLED=true
# METRICS_PORT=9090

# Sentry（エラートラッキング）
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========================================
# テスト環境設定
# ========================================
# TEST_DB_HOST=localhost
# TEST_DB_PORT=33060
# TEST_DB_USER=test_user
# TEST_DB_PASSWORD=test_password
# TEST_DB_NAME=matching_engine_test
