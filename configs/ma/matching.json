{
  "version": "1.0",
  "domain": "ma",
  "description": "M&A matching configuration with weighted scoring components",
  "scoring": {
    "min_score": 0.30,
    "components": [
      {
        "name": "financial_health",
        "type": "euclidean",
        "fields": ["ebitda_margin", "roe", "roa", "debt_equity_ratio", "current_ratio"],
        "weight": 0.25
      },
      {
        "name": "industry_synergy",
        "type": "categorical",
        "field": "industry",
        "weight": 0.15
      },
      {
        "name": "technology_overlap",
        "type": "jaccard",
        "field": "technology",
        "weight": 0.25
      },
      {
        "name": "market_overlap",
        "type": "jaccard",
        "field": "market",
        "weight": 0.20
      },
      {
        "name": "location_match",
        "type": "categorical",
        "field": "location",
        "weight": 0.15
      }
    ]
  },
  "ranking": {
    "sort_order": "desc",
    "limit": 30,
    "diversity": {
      "enabled": true,
      "group_by_field": "industry",
      "max_per_group": 10
    },
    "random_factor": 0.0
  }
}
